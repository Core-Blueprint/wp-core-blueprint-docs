#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PACKAGE="core-blueprint-docs"
MAIN_FILE="core-blueprint-docs.php"
ENTRY="$ROOT/$MAIN_FILE"
DIST="$ROOT/dist"
STAGE="$(mktemp -d)"
PACKAGE_ROOT="$STAGE/$PACKAGE"
LOCALES=(nl_NL de_DE fr_FR es_ES it_IT pt_PT)
trap 'rm -rf "$STAGE"' EXIT

fail() {
  printf 'Docs release build failed: %s\n' "$*" >&2
  exit 1
}

header_value() {
  local file="$1" label="$2"
  php -r '
    $lines = @file($argv[1], FILE_IGNORE_NEW_LINES);
    if (!is_array($lines)) { exit(2); }
    $label = preg_quote($argv[2], "/");
    foreach ($lines as $line) {
      if (preg_match("/^\\s*\\*?\\s*{$label}:\\s*(.*?)\\s*$/", $line, $m)) {
        echo $m[1];
        exit(0);
      }
    }
  ' "$file" "$label"
}

define_value() {
  local file="$1" name="$2"
  php -r '
    $source = @file_get_contents($argv[1]);
    if (!is_string($source)) { exit(2); }
    $name = preg_quote($argv[2], "/");
    if (preg_match("/define\\(\\s*[\\x27\\x22]{$name}[\\x27\\x22]\\s*,\\s*[\\x27\\x22]([^\\x27\\x22]+)[\\x27\\x22]\\s*\\)/", $source, $m)) {
      echo $m[1];
    }
  ' "$file" "$name"
}

[[ -f "$ENTRY" ]] || fail "plugin entrypoint is missing"

VERSION="$(header_value "$ENTRY" 'Version')"
REQUIRES_WP="$(header_value "$ENTRY" 'Requires at least')"
REQUIRES_PHP="$(header_value "$ENTRY" 'Requires PHP')"
REQUIRES_PLUGINS="$(header_value "$ENTRY" 'Requires Plugins')"
TEXT_DOMAIN="$(header_value "$ENTRY" 'Text Domain')"
DOMAIN_PATH="$(header_value "$ENTRY" 'Domain Path')"
CONSTANT_VERSION="$(define_value "$ENTRY" 'CB_DOCS_VERSION')"
REQUIRED_API="$(define_value "$ENTRY" 'CB_DOCS_REQUIRED_API')"

[[ "$VERSION" == '1.0.0-rc1' ]] || fail "release version must remain 1.0.0-rc1"
[[ "$CONSTANT_VERSION" == "$VERSION" ]] || fail "Version header and CB_DOCS_VERSION differ"
[[ "$REQUIRES_WP" == '7.0' ]] || fail "Requires at least must remain 7.0"
[[ "$REQUIRES_PHP" == '8.4' ]] || fail "Requires PHP must remain 8.4"
[[ "$REQUIRES_PLUGINS" == 'core-blueprint' ]] || fail "Requires Plugins must declare core-blueprint"
[[ "$TEXT_DOMAIN" == "$PACKAGE" ]] || fail "Text Domain must remain $PACKAGE"
[[ "$DOMAIN_PATH" == '/languages' ]] || fail "Domain Path must remain /languages"
[[ "$REQUIRED_API" == '1.1' ]] || fail "CB_DOCS_REQUIRED_API must remain 1.1"
grep -Fq "Stable tag: $VERSION" readme.txt || fail "readme.txt Stable tag does not match plugin header"
grep -Fq "## v$VERSION scope" README.md || fail "README public scope version does not match plugin header"
grep -Fq "## $VERSION" CHANGELOG.md || fail "CHANGELOG public version does not match plugin header"

for command in php python3 git wp msgfmt node zip unzip sha256sum find sort touch grep; do
  command -v "$command" >/dev/null 2>&1 || fail "missing required command: $command"
done
php -r 'exit(version_compare(PHP_VERSION, "8.4", ">=") ? 0 : 1);' \
  || fail "PHP 8.4 or newer is required to build Docs"

if [[ -n "$(git status --porcelain --untracked-files=all -- . ':!dist' ':!build')" ]]; then
  fail "working tree contains uncommitted release-source changes"
fi

echo "==> Running canonical Docs checks"
"$ROOT/tools/check"

rm -rf "$DIST"
mkdir -p "$DIST" "$PACKAGE_ROOT/languages"
ZIP="$DIST/$PACKAGE-$VERSION.zip"
CHECKSUM="$ZIP.sha256"

for path in "$MAIN_FILE" uninstall.php readme.txt README.md CHANGELOG.md; do
  [[ -f "$ROOT/$path" ]] || fail "required release file is missing: $path"
  cp "$ROOT/$path" "$PACKAGE_ROOT/"
done
for path in src assets; do
  [[ -d "$ROOT/$path" ]] || fail "required release directory is missing: $path"
  cp -R "$ROOT/$path" "$PACKAGE_ROOT/"
done

POT_SOURCE="$ROOT/languages/$PACKAGE.pot"
[[ -s "$POT_SOURCE" ]] || fail "canonical POT is missing: languages/$PACKAGE.pot"
cp "$POT_SOURCE" "$PACKAGE_ROOT/languages/"

for locale in "${LOCALES[@]}"; do
  po_source="$ROOT/languages/$PACKAGE-${locale}.po"
  po="$PACKAGE_ROOT/languages/$PACKAGE-${locale}.po"
  mo="$PACKAGE_ROOT/languages/$PACKAGE-${locale}.mo"
  [[ -s "$po_source" ]] || fail "reviewed PO is missing for $locale"
  cp "$po_source" "$po"
  msgfmt --check-format --check-header -o "$mo" "$po"
  [[ -s "$mo" ]] || fail "compiled MO is missing for $locale"
done

echo "==> Validating staged runtime"
while IFS= read -r -d '' file; do
  php -l "$file" >/dev/null || fail "staged PHP lint failed: $file"
done < <(find "$PACKAGE_ROOT" -type f -name '*.php' -print0)
while IFS= read -r -d '' file; do
  node --check "$file" >/dev/null || fail "staged JavaScript syntax failed: $file"
done < <(find "$PACKAGE_ROOT/assets" -type f -name '*.js' -print0)

find "$PACKAGE_ROOT" -type f \( -name '.DS_Store' -o -name '*.map' -o -name '*.pyc' \) -delete
find "$PACKAGE_ROOT" -type d -name '__pycache__' -prune -exec rm -rf {} +
find "$PACKAGE_ROOT" -exec touch -t 198001010000 {} +
(
  cd "$STAGE"
  zip -X -q "$ZIP" "$PACKAGE/"
  find "$PACKAGE" -type f -print | LC_ALL=C sort | zip -X -q "$ZIP" -@
)

[[ -s "$ZIP" ]] || fail "release ZIP was not created"
unzip -tqq "$ZIP" || fail "release ZIP integrity check failed"
ZIP_ENTRIES="$(unzip -Z1 "$ZIP")"
[[ -n "$ZIP_ENTRIES" ]] || fail "release ZIP is empty"
FIRST_ENTRY="${ZIP_ENTRIES%%$'\n'*}"
[[ "$FIRST_ENTRY" == "$PACKAGE/" ]] || fail "release ZIP root is not $PACKAGE/"

while IFS= read -r entry; do
  [[ "$entry" == "$PACKAGE/"* ]] || fail "unexpected archive root entry: $entry"
done <<<"$ZIP_ENTRIES"

if grep -Eq '(^|/)(\.git|\.github|tests|tools|docs|dist|build|node_modules|vendor|\.venv)(/|$)' <<<"$ZIP_ENTRIES"; then
  fail "development-only files leaked into the release ZIP"
fi

for required in \
  "$PACKAGE/$MAIN_FILE" \
  "$PACKAGE/uninstall.php" \
  "$PACKAGE/readme.txt" \
  "$PACKAGE/README.md" \
  "$PACKAGE/CHANGELOG.md" \
  "$PACKAGE/languages/$PACKAGE.pot"; do
  grep -Fxq "$required" <<<"$ZIP_ENTRIES" || fail "required release file missing from ZIP: $required"
done
for locale in "${LOCALES[@]}"; do
  for ext in po mo; do
    required="$PACKAGE/languages/$PACKAGE-${locale}.${ext}"
    grep -Fxq "$required" <<<"$ZIP_ENTRIES" || fail "required catalog missing from ZIP: $required"
  done
done

PACKAGED_ENTRY="$PACKAGE_ROOT/$MAIN_FILE"
[[ "$(header_value "$PACKAGED_ENTRY" 'Version')" == "$VERSION" ]] || fail "packaged Version header differs from verified source"
[[ "$(define_value "$PACKAGED_ENTRY" 'CB_DOCS_VERSION')" == "$VERSION" ]] || fail "packaged CB_DOCS_VERSION differs from verified source"
[[ "$(define_value "$PACKAGED_ENTRY" 'CB_DOCS_REQUIRED_API')" == "$REQUIRED_API" ]] || fail "packaged Core API requirement differs from source"
[[ "$(header_value "$PACKAGED_ENTRY" 'Requires Plugins')" == 'core-blueprint' ]] || fail "packaged Requires Plugins identity is invalid"
[[ "$(header_value "$PACKAGED_ENTRY" 'Text Domain')" == "$PACKAGE" ]] || fail "packaged Text Domain identity is invalid"

(
  cd "$DIST"
  sha256sum "$(basename "$ZIP")" > "$(basename "$CHECKSUM")"
)
[[ -s "$CHECKSUM" ]] || fail "release checksum was not created"
SHA256="$(awk '{print $1}' "$CHECKSUM")"
printf 'Docs release build: PASS\nPackage: %s\nVersion: %s\nCanonical root: %s/\nSHA-256: %s\n' "$ZIP" "$VERSION" "$PACKAGE" "$SHA256"
