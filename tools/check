#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

fail() {
  printf 'Docs checks failed: %s\n' "$*" >&2
  exit 1
}

header_value() {
  local file="$1" label="$2"
  php -r '
    $lines = @file($argv[1], FILE_IGNORE_NEW_LINES);
    if (!is_array($lines)) { exit(2); }
    $label = preg_quote($argv[2], "/");
    foreach ($lines as $line) {
      if (preg_match("/^\\s*\\*?\\s*{$label}:\\s*(.*?)\\s*$/", $line, $m)) {
        echo $m[1];
        exit(0);
      }
    }
  ' "$file" "$label"
}

define_value() {
  local file="$1" name="$2"
  php -r '
    $source = @file_get_contents($argv[1]);
    if (!is_string($source)) { exit(2); }
    $name = preg_quote($argv[2], "/");
    if (preg_match("/define\\(\\s*[\\x27\\x22]{$name}[\\x27\\x22]\\s*,\\s*[\\x27\\x22]([^\\x27\\x22]+)[\\x27\\x22]\\s*\\)/", $source, $m)) {
      echo $m[1];
    }
  ' "$file" "$name"
}

VERSION="$(header_value "$ROOT/core-blueprint-docs.php" 'Version')"
CONSTANT_VERSION="$(define_value "$ROOT/core-blueprint-docs.php" 'CB_DOCS_VERSION')"
README_VERSION="$(awk '/^Stable tag:/ {print $3; exit}' "$ROOT/readme.txt")"

[[ -n "$VERSION" ]] || fail "could not resolve plugin version"
[[ "$VERSION" == "$CONSTANT_VERSION" ]] || fail "Version header and CB_DOCS_VERSION differ"
[[ "$VERSION" == "$README_VERSION" ]] || fail "plugin version and readme Stable tag differ"
[[ "$VERSION" == "1.0.0-rc1" ]] || fail "release version must remain 1.0.0-rc1"

for command in php python3 git wp msgfmt node; do
  command -v "$command" >/dev/null 2>&1 || fail "missing required command: $command"
done

PHP_VERSION="$(php -r 'echo PHP_VERSION;')"
php -r 'exit(version_compare(PHP_VERSION, "8.4", ">=") ? 0 : 1);' || {
  printf 'ERROR: PHP 8.4+ is required for Docs checks (found %s).\n' "$PHP_VERSION" >&2
  exit 1
}

while IFS= read -r -d '' file; do
  php -l "$file" >/dev/null || fail "PHP lint failed: $file"
done < <(find . \
  -path './.git' -prune -o \
  -path './dist' -prune -o \
  -path './build' -prune -o \
  -path './vendor' -prune -o \
  -path './.venv' -prune -o \
  -type f -name '*.php' -print0)

echo "PHP syntax: PASS"

while IFS= read -r -d '' file; do
  node --check "$file" >/dev/null || fail "JavaScript syntax failed: $file"
done < <(find assets -type f -name '*.js' -print0)

bash -n "$ROOT/tools/build-release" || fail "release builder shell syntax failed"

"$ROOT/tools/i18n/check"
php "$ROOT/tools/conformance.php"

for test in \
  adjacent-navigation-regression.php \
  admin-list-filters-smoke.php \
  bootstrap-v1-smoke.php \
  bricks-adapter-smoke.php \
  bricks-styling-regression.php \
  content-model-smoke.php \
  frontend-read-policy-smoke.php \
  integration-preferences-regression.php \
  organizer-contract-smoke.php \
  organizer-order-regression.php \
  organizer-structure-regression.php \
  permalink-contract-smoke.php \
  permalink-route-regression.php; do
  php "$ROOT/tests/$test"
done

echo "Core Blueprint Docs checks: PASS"
