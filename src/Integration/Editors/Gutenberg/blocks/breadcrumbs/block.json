{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "core-blueprint-docs/breadcrumbs",
  "version": "1.0.0-rc1",
  "title": "Docs Breadcrumbs",
  "category": "core-blueprint",
  "icon": "arrow-right-alt",
  "description": "Display breadcrumbs for the current documentation context.",
  "textdomain": "core-blueprint-docs",
  "attributes": {},
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "editorScript": "cb-docs-block-editor"
}
