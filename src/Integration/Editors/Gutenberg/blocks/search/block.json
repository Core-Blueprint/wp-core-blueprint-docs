{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "core-blueprint-docs/search",
  "version": "1.0.0-rc1",
  "title": "Docs Search",
  "category": "core-blueprint",
  "icon": "search",
  "description": "Display the canonical live documentation search.",
  "textdomain": "core-blueprint-docs",
  "attributes": {
    "placeholder": {
      "type": "string",
      "default": "Search documentation…"
    },
    "limit": {
      "type": "number",
      "default": 20
    },
    "minChars": {
      "type": "number",
      "default": 2
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "showCategory": {
      "type": "boolean",
      "default": true
    },
    "category": {
      "type": "string",
      "default": ""
    },
    "tag": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "editorScript": "cb-docs-block-editor"
}
